<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smartbeauty.classic">

    <!-- Permission pour accéder à Internet (appels vers le backend Spring Boot) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SmartBeauty">

        <activity
            android:name=".SalonDetailActivity"
            android:exported="false" />
        <activity
            android:name=".SalonsActivity"
            android:exported="false" />
        <activity
            android:name=".AccueilActivity"
            android:exported="false" />
        <activity
            android:name=".InscriptionActivity"
            android:exported="false" />
        <activity
            android:name=".ConnexionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
